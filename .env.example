# Explicit launchers load .env; deployment environment wins. Never commit actual secrets.
APP_ENV=development
FLASK_SECRET_KEY=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
PORT=5000
DATA_DIR=./data

TRADING_MODE=paper
BINANCE_VENUE=testnet
ALLOW_EXCHANGE_EXECUTION=false
ALLOW_MAINNET_EXECUTION=false
AUTOMATION_ENABLED=false

# Paper clients never receive private credentials.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
# PAPER_TRADING/TESTNET aliases are supported with conflict rejection.
# Generic API_KEY/SECRET or BINANCE_API_KEY/SECRET additionally require CREDENTIAL_VENUE.

BASE_QUOTE=USDT
UNIVERSE_SIZE=12
MIN_24H_QUOTE_VOLUME=10000000
NEAR_EMA_PCT=0.02
RSI_THRESHOLD=30
RSI_EXEC_THRESHOLD=45
RSI_OVERBOUGHT=70
TAKE_PROFIT_PCT=0.06
STOP_LOSS_PCT=0.03
TRAILING_PCT=0.03
EQUITY_PROXY=1000
LOOKBACK_DAYS=90
BACKTEST_START=2021-01-01
BACKTEST_END=2024-12-31
WHITELIST=
BLACKLIST=
COOLDOWN_MINUTES=120
LOOP_INTERVAL_SECONDS=300
